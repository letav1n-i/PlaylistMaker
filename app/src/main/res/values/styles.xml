<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="main_background">
        <item name="android:background">@color/main_screen_background</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="default_btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">@dimen/icon_padding_from_text</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/large_padding</item>
        <item name="android:paddingBottom">@dimen/large_padding</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">@dimen/small_text_size</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:drawableTint">@color/icon_secondary</item>
    </style>

    <style name="back_btn_toolbar">
        <item name="android:layout_width">@dimen/toolbar_icon_size</item>
        <item name="android:layout_height">@dimen/toolbar_icon_size</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:src">@drawable/ic_arrow_back_24</item>
        <item name="android:tint">@color/icon_color</item>
        <item name="android:contentDescription">@string/accessibility_back</item>
    </style>

    <style name="title_toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/toolbar_title_padding</item>
        <item name="android:layout_marginRight">@dimen/toolbar_title_padding</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">@dimen/default_text_size</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="main_toolbar">
        <item name="android:paddingStart">@dimen/toolbar_basic_padding</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:layout_marginBottom">@dimen/toolbar_indent_to_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/yp_white</item>
        <item name="android:textSize">@dimen/default_text_size</item>
    </style>

    <style name="additional_toolbar_without_btn" parent="main_toolbar">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">@dimen/default_text_size</item>
        <item name="android:paddingStart">@dimen/default_padding</item>
        <item name="android:paddingEnd">@dimen/default_padding</item>
    </style>

    <style name="search_input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginHorizontal">@dimen/default_padding</item>
        <item name="android:background">@drawable/search_background</item>
        <item name="android:drawableStart">@drawable/ic_search_light_16</item>
        <item name="android:drawablePadding">@dimen/icon_padding_from_text</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingTop">8.5dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:hint">@string/search</item>
        <item name="android:paddingBottom">8.5dp</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textColorHint">@color/hint_color</item>
        <item name="android:textSize">@dimen/small_text_size</item>
        <item name="android:drawableTint">@color/hint_color</item>
    </style>

    <style name="clear_search_btn">
        <item name="android:tint">@color/hint_color</item>
    </style>

    <style name="big_button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/yp_white</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textSize">@dimen/default_text_size</item>
        <item name="cornerRadius">@dimen/default_padding</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/icon_padding_from_text</item>
        <item name="iconTint">@color/yp_black</item>
    </style>

    <style name="track_item">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">@dimen/base_track_padding</item>
        <item name="android:paddingTop">@dimen/small_padding</item>
        <item name="android:paddingRight">@dimen/small_track_padding</item>
        <item name="android:paddingBottom">@dimen/small_padding</item>
    </style>

    <style name="track_cover">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginRight">@dimen/small_padding</item>
        <item name="android:contentDescription">@string/accessibility_track_cover</item>
    </style>

    <style name="track_arrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:src">@drawable/ic_arrow_right_24</item>
        <item name="android:tint">@color/icon_secondary</item>
    </style>

    <style name="track_name">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/ys_text_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/small_text_size</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_marginBottom">@dimen/micro_padding</item>
    </style>

    <style name="track_subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/ys_text_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/subtitle_track_text_size</item>
        <item name="android:textColor">@color/text_subtitle_color</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="track_subtitle_separator">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/ic_text_separator_13</item>
        <item name="android:backgroundTint">@color/icon_secondary</item>
    </style>

</resources>
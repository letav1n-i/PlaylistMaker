<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/additional_screen_background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/main_toolbar"
        android:layout_marginBottom="0dp">

        <ImageButton
            android:id="@+id/back_btn_toolbar"
            style="@style/back_btn_toolbar" />

        <TextView
            style="@style/title_toolbar"
            android:text="@string/search" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/search_edit_text"
            style="@style/search_input"
            android:imeOptions="actionDone"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/clear_btn"
            style="@style/clear_search_btn"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginStart="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/search_background"
            android:contentDescription="@string/accessibility_clear"
            android:src="@drawable/ic_clear_light_16"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/emptyResultPlaceholder"
        style="@style/placeholder_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            style="@style/placeholder_image"
            android:contentDescription="@string/empty_placeholder"
            android:src="@drawable/ci_placeholder_empty_120" />

        <TextView
            style="@style/placeholder_text"
            android:text="@string/empty_placeholder" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorPlaceholder"
        style="@style/placeholder_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            style="@style/placeholder_image"
            android:contentDescription="@string/error_placeholder"
            android:src="@drawable/ci_placeholder_error_internet_120" />

        <TextView
            style="@style/placeholder_text"
            android:layout_marginBottom="@dimen/placeholder_side_margin"
            android:text="@string/error_placeholder" />

        <Button
            android:id="@+id/refreshSearchButton"
            style="@style/refresh_button"
            android:text="@string/refresh" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tracksList"
        android:layout_width="match_parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:layout_height="match_parent"
        tools:itemCount="5"
        tools:listitem="@layout/track_view" />
</LinearLayout>